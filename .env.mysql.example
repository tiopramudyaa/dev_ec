# Password user root MySQL
MYSQL_ROOT_PASSWORD=
# Database utama, dibuat otomatis (dipakai EcoSystem), contoh: ecosystem
# Database JARVIES (prod) dibuat oleh docker/mysql-init/01-databases.sh
MYSQL_DATABASE=
# User aplikasi -> isi sama di DB_USERNAME pada .env Laravel
MYSQL_USER=
# Password user aplikasi -> isi sama di DB_PASSWORD pada .env Laravel
MYSQL_PASSWORD=
